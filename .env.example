# LLM used by the agent (free key at https://console.groq.com)
GROQ_API_KEY=

# Hosted Postgres (e.g. Neon). When set, it overrides the POSTGRES_* values below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local / docker-compose database
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_secret
POSTGRES_DB=argus_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: LangSmith tracing for the /investigate endpoint
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
